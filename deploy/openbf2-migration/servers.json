{
  "_comment": "Inventory for the OpenBF2 migration. No secrets here: RCON passwords and API keys are carried over from the running containers (docker inspect), admin keys and the pin come from 1Password. serverId must equal dbo.Server.ServerId (03-database.ps1 -Check shows the rows); it is the module's adminServerId.",
  "webAdmin": {
    "version": "0.1.0",
    "image": "docker.io/nihlen/bf2-webadmin",
    "adminConnect": "bf2wa.nihlen.net:4300",
    "url": "https://bf2wa.nihlen.net"
  },
  "cluster": {
    "kubeconfig": "/mnt/c/Data/Projects/pve-cluster/kubernetes/kubeconfig",
    "repo": "C:\\Data\\Projects\\pve-cluster",
    "namespace": "bf2",
    "deployment": "bf2-webadmin",
    "mssqlPod": "mssql-0",
    "database": "bf2",
    "backupCronJob": "mssql-backup"
  },
  "onePassword": {
    "vault": "Kubernetes",
    "webAdminItem": "bf2-webadmin-env",
    "gameServersItem": "bf2-gameservers"
  },
  "gameplay": {
    "_comment": "OpenBF2 TV missile settings, off (retail) for the first release. Set e.g. tvAimFromMissile 50 and tvTurnBehind 1 and redeploy to enable",
    "tvAimFromMissile": "0",
    "tvTurnBehind": "0"
  },
  "hosts": [
    { "alias": "de2", "ip": "45.76.95.172", "composeFile": "/data/docker-compose.yml" },
    { "alias": "de", "ip": "45.76.81.207", "composeFile": "/data/docker-compose.yml" }
  ],
  "servers": [
    {
      "name": "netsky-de-2v2",
      "host": "de2",
      "service": "bf2-netsky-2v2",
      "image": "cr.nihlen.net/library/bf2-netsky:openbf2-2v2",
      "retailImage": "cr.nihlen.net/library/bf2-netsky:2v2",
      "serverId": "45.76.95.172:16567",
      "gamePort": 16567, "queryPort": 29900, "rconPort": 4711,
      "ports": ["8000:80/tcp", "4711:4711/tcp", "4712:4712/tcp", "16567:16567/udp", "27901:27901/udp", "29900:29900/udp"]
    },
    {
      "name": "netsky-de-2v2-nocheck",
      "host": "de2",
      "service": "bf2-netsky-2v2-nocheck",
      "image": "cr.nihlen.net/library/bf2-netsky:openbf2-2v2-nocheck",
      "retailImage": "cr.nihlen.net/library/bf2-netsky:2v2-nocheck",
      "serverId": "45.76.95.172:16569",
      "gamePort": 16569, "queryPort": 29901, "rconPort": 4721,
      "ports": ["8001:80/tcp", "4721:4711/tcp", "4722:4712/tcp", "16569:16569/udp", "27911:27901/udp", "29901:29901/udp"]
    },
    {
      "name": "netsky-de-dogfight",
      "host": "de",
      "service": "bf2-netsky-dogfight",
      "image": "cr.nihlen.net/library/bf2-netsky:openbf2-dogfight",
      "retailImage": "cr.nihlen.net/library/bf2-netsky:dogfight",
      "serverId": "45.76.81.207:16571",
      "gamePort": 16571, "queryPort": 29903, "rconPort": 4741,
      "ports": ["8003:80/tcp", "4741:4711/tcp", "4742:4712/tcp", "16571:16571/udp", "27931:27901/udp", "29903:29903/udp"]
    },
    {
      "name": "netsky-de-chopper-mayhem",
      "host": "de",
      "service": "bf2-netsky-chopper-mayhem",
      "image": "cr.nihlen.net/library/bf2-netsky:openbf2-chopper-mayhem",
      "retailImage": "cr.nihlen.net/library/bf2-netsky:chopper-mayhem",
      "serverId": "45.76.81.207:16572",
      "gamePort": 16572, "queryPort": 29904, "rconPort": 4731,
      "ports": ["8002:80/tcp", "4731:4711/tcp", "4732:4712/tcp", "16572:16572/udp", "27921:27901/udp", "29904:29904/udp"]
    }
  ],
  "canary": {
    "_comment": "Phase 0 on de2: the existing OpenBF2 test server's slot (ports 16570/29902/4723) runs the new image on the internet, without the admin channel (WebAdmin 0.0.2 cannot accept it). Run from its own compose project in /data/openbf2-canary so the main compose file is not touched before migration day.",
    "name": "netsky-de-openbf2-2v2-nocheck",
    "host": "de2",
    "service": "bf2-netsky-openbf2-2v2-nocheck",
    "image": "cr.nihlen.net/library/bf2-netsky:openbf2-2v2-nocheck",
    "gamePort": 16570, "queryPort": 29902, "rconPort": 4723,
    "ports": ["8002:80/tcp", "4723:4711/tcp", "4724:4712/tcp", "16570:16570/udp", "27912:27901/udp", "29902:29902/udp"]
  }
}
