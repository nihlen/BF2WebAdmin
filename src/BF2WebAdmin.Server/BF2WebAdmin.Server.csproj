<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BF2WebAdmin.Server</AssemblyName>
    <OutputType>Exe</OutputType>
    <PackageId>BF2WebAdmin.Server</PackageId>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerfileTag>bf2-webadmin</DockerfileTag>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <LangVersion>default</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The OpenAPI document of the web API, for the web UI's TypeScript types. Written by "npm run api" in
       src/BF2WebAdmin.Web, which builds with OpenApiGenerateDocuments=true; normal builds skip it. -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\BF2WebAdmin.Web\src\api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!-- The web UI (src/BF2WebAdmin.Web): "dotnet publish" builds it with npm and publishes its dist folder as wwwroot.
       Container images built by Aspire get it from the AppHost (PublishWithContainerFiles) instead, and
       -p:SkipWebBuild=true skips it. -->
  <PropertyGroup>
    <WebRoot>$(MSBuildProjectDirectory)\..\BF2WebAdmin.Web\</WebRoot>
  </PropertyGroup>

  <Target Name="PublishWeb" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec WorkingDirectory="$(WebRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(WebRoot)" Command="npm run build" />
    <ItemGroup>
      <WebDist Include="$(WebRoot)dist\**" />
      <ResolvedFileToPublish Include="@(WebDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- The game scripts (GameScripts/src/*.ts, docs/scripts.md): TypeScript that WebAdmin pushes to a game server's
       module. "npm run build" type checks them and writes GameScripts/dist/<name>.js with the types blanked out; the
       build embeds those as resources named GameScripts/<name>.js. Needs Node (the version pinned in
       GameScripts/package.json) when a script or its build files changed since the last build;
       -p:SkipGameScripts=true embeds what dist already holds. -->
  <PropertyGroup>
    <GameScriptsRoot>$(MSBuildProjectDirectory)\GameScripts\</GameScriptsRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not content of the web app: nothing of the npm project is published as a file -->
    <Content Remove="GameScripts\**" />
    <None Remove="GameScripts\**" />
    <GameScriptInput Include="$(GameScriptsRoot)src\**\*.ts;$(GameScriptsRoot)game.d.ts;$(GameScriptsRoot)build.mjs;$(GameScriptsRoot)tsconfig.json;$(GameScriptsRoot)package.json;$(GameScriptsRoot)package-lock.json" />
  </ItemGroup>

  <Target Name="BuildGameScripts" Inputs="@(GameScriptInput)" Outputs="$(GameScriptsRoot)dist\.built" Condition="'$(SkipGameScripts)' != 'true'">
    <Exec WorkingDirectory="$(GameScriptsRoot)" Command="npm ci" Condition="!Exists('$(GameScriptsRoot)node_modules')" />
    <Exec WorkingDirectory="$(GameScriptsRoot)" Command="npm run build" />
    <Touch Files="$(GameScriptsRoot)dist\.built" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedGameScripts" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildGameScripts">
    <ItemGroup>
      <GameScriptOutput Include="$(GameScriptsRoot)dist\*.js" />
      <EmbeddedResource Include="@(GameScriptOutput)" LogicalName="GameScripts/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="'@(GameScriptOutput)' == ''" Text="No game scripts in $(GameScriptsRoot)dist: build them with 'npm run build' in GameScripts (needs Node), or build without -p:SkipGameScripts=true." />
  </Target>

  <!-- Fix for publish error detected package downgrade -->
  <PropertyGroup>
    <WarningsAsErrors>
    </WarningsAsErrors>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <DockerfileTag>bf2-webadmin</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BF2WebAdmin.Common\BF2WebAdmin.Common.csproj" />
    <ProjectReference Include="..\BF2WebAdmin.Data\BF2WebAdmin.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.Authentication.ApiKey" Version="9.0.0" />
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Polly" Version="8.9.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configuration\appsecrets.debug.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsecrets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsecrets.release.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsettings.debug.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\appsettings.release.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="GeoLite2-Country.mmdb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Logs\Placeholder.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Hubs\" />
    <Folder Include="Data\" />
    <Folder Include="Services\" />
    <Folder Include="Properties\PublishProfiles\" />
    <Folder Include="ServerLogs\" />
  </ItemGroup>

</Project>